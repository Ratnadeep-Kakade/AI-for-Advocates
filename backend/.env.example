CICERO_APP_NAME=Cicero API
CICERO_ENVIRONMENT=development
CICERO_LOG_LEVEL=INFO

# Meta Model API: Muse Spark for the Request Interpreter and Orchestrator.
MODEL_API_KEY=
CICERO_META_BASE_URL=https://api.meta.ai/v1
CICERO_INTERPRETER_PROVIDER=meta
CICERO_INTERPRETER_MODEL=muse-spark-1.3
CICERO_ORCHESTRATOR_PROVIDER=meta
CICERO_ORCHESTRATOR_MODEL=muse-spark-1.3
# Gemini (Google Search grounding intermediary for the Legal Researcher).
CICERO_GEMINI_API_KEY=<gemini-api-key>
CICERO_GEMINI_MODEL=gemini-2.5-flash

# Document Intelligence runs on Muse Spark (fed by the RAG evidence pack).
CICERO_DOCUMENT_INTELLIGENCE_PROVIDER=meta
CICERO_DOCUMENT_INTELLIGENCE_MODEL=muse-spark-1.3
# Demo default: the other four specialists also run on Muse Spark so the
# full flow works end-to-end. Switch them to the Modal GPU inference service
# (DeepSeek-R1-Distill-Llama-70B) once cicero-llama-inference is deployed:
# provider=vllm_modal, model=deepseek-r1-distill-llama-70b, CICERO_VLLM_BASE_URL set.
CICERO_LEGAL_RESEARCHER_PROVIDER=meta
CICERO_LEGAL_RESEARCHER_MODEL=muse-spark-1.3
CICERO_ARGUMENT_PROVIDER=meta
CICERO_ARGUMENT_MODEL=muse-spark-1.3
CICERO_COUNTERARGUMENT_PROVIDER=meta
CICERO_COUNTERARGUMENT_MODEL=muse-spark-1.3
CICERO_EVALUATOR_PROVIDER=meta
CICERO_EVALUATOR_MODEL=muse-spark-1.3

# Separate vLLM inference service (configure later).
CICERO_VLLM_BASE_URL=
CICERO_VLLM_API_KEY=
CICERO_GENERIC_BASE_URL=
CICERO_GENERIC_API_KEY=
CICERO_MODEL_TIMEOUT_SECONDS=300
CICERO_MODEL_MAX_RETRIES=2

# Cloud SQL Python Connector.
# Instance connection name format: project-id:region:instance-name
CICERO_DATABASE_INSTANCE_CONNECTION_NAME=project-d05a24bb-cf47-4351-b6e:asia-south1:legal-ai-db
CICERO_DATABASE_NAME=legal_ai
CICERO_DATABASE_USER=legal_ai_app
CICERO_DATABASE_PASSWORD=
CICERO_DATABASE_IP_TYPE=public
CICERO_DATABASE_REFRESH_STRATEGY=lazy
CICERO_DATABASE_POOL_SIZE=3
CICERO_DATABASE_MAX_OVERFLOW=2
CICERO_DATABASE_POOL_TIMEOUT_SECONDS=30
CICERO_DATABASE_POOL_RECYCLE_SECONDS=1800

# Modal Workload Identity Federation identifiers (non-secret).
# Google Workload Identity Federation (non-secret identifiers)
CICERO_DATABASE_WIF_PROJECT_NUMBER=116460390489
CICERO_DATABASE_WIF_POOL_ID=cicero-modal-pool
CICERO_DATABASE_WIF_PROVIDER_ID=modal-oidc
CICERO_DATABASE_WIF_SERVICE_ACCOUNT_EMAIL=cicero-backend@project-d05a24bb-cf47-4351-b6e.iam.gserviceaccount.com


# Google Cloud Storage for private legal document objects.
CICERO_GCS_PROJECT_ID=project-d05a24bb-cf47-4351-b6e
CICERO_GCS_BUCKET_NAME=cicero-legal-documents-1575
CICERO_GCS_UPLOAD_URL_EXPIRY_SECONDS=900
CICERO_GCS_DOWNLOAD_URL_EXPIRY_SECONDS=300
CICERO_GCS_MAX_FILE_SIZE_BYTES=209715200


# Optional Pub/Sub topic for dispatching completed uploads to the Cloud Run RAG worker.
CICERO_PUBSUB_DOCUMENT_TOPIC=projects/PROJECT_ID/topics/cicero-document-processing
CICERO_RAG_WORKER_URL=https://<CLOUD_RUN_SERVICE_URL>
CICERO_RAG_SERVICE_TOKEN=<store-in-secret-manager-and-modal-secret>
